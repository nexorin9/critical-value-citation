# 危急值处置依据检索系统 · 配置样例
#
# 复制为 .env 后按院内实际填写；也可直接用系统环境变量注入。
# 代码内不出现任何真实密钥；所有凭据位一律从环境变量读取。
# 本文件只列凭据位与默认值，值一律留空或使用占位符。

# ---------- 出站：企业微信群机器人（写） ----------
# 值班群推送通道，群机器人 webhook 完整 URL（含 key 参数）
CRITVAL_WECOM_WEBHOOK_URL=

# ---------- 出站：院内危急值登记 / 护理执行平台（写） ----------
# 登记系统基地址，用于回写回执
CRITVAL_BASE_URL=
# 回写接口的 Bearer 凭据
CRITVAL_TOKEN=

# ---------- 出站：排班 / 值班名单系统（读） ----------
# 排班系统基地址，用于查询当班人
NURSE_ROSTER_BASE_URL=
# 排班系统接口的 Bearer 凭据
ROSTER_TOKEN=

# ---------- 入站：LIS 危急值推送（辅通道，HTTP） ----------
# LIS 推送回调的基地址（本守护进程对外监听地址）
CRITVAL_LISTEN_BASE_URL=http://127.0.0.1:8760
# LIS 携带的共享 Bearer 凭据，本系统校验时做常量时间比较
LIS_CRITICAL_TOKEN=
# LIS REST 回调基地址（部分厂商以此地址回调本系统）
LIS_BASE_URL=

# ---------- 入站：HL7 v2 MLLP 监听（主通道） ----------
# 监听地址与端口，形如 0.0.0.0:2575
LIS_MLLP_BIND=

# ---------- 值班台访问控制 ----------
# 值班台页面与确认接口的访问令牌
CONSOLE_TOKEN=

# ---------- 运行期本地路径 ----------
# SQLite 台账 / 审计 / 幂等键库文件位置
CRITVAL_DB_PATH=./data/critval.db
# 配置快照落盘目录（每次热载入留一份脱敏快照，供事后复核）
CRITVAL_CONFIG_SNAPSHOT_DIR=./reports/config_snapshots

# ---------- 材料与入站通道参数 ----------
# 院内危急值阈值表 xlsx（判定权威）。默认指向仓库内示例材料；
# 院内上线必须改成院内危急值标准文件的实际路径。
CRITVAL_THRESHOLD_PATH=./samples/threshold/示例危急值阈值表.xlsx
# 入站推送请求体上限（字节）。危急值推送是一条结果，64 KiB 足够；超了直接拒。
CRITVAL_INBOUND_MAX_BODY_BYTES=65536
# 入站推送限流：单来源地址每分钟允许的处理次数
CRITVAL_INBOUND_RATE_LIMIT_PER_MINUTE=120
# 合并通知时间窗（秒）：同标本、同科室、观察时刻相隔在该窗口内的多个危急项目
# 合并成一张处置卡（一条标本一张卡），避免值班群被刷屏。默认 300 秒。
CRITVAL_MERGE_WINDOW_SECONDS=300

# ---------- 通知投递可靠性（退避重试 / 死信 / 重复投递抑制） ----------
# 本机通知队列文件：企微未配置或重试耗尽时，处置卡正文落这里（值班台可见）
CRITVAL_LOCAL_NOTIFICATION_PATH=./data/local_notifications.jsonl
# 单轮投递最多尝试几次（含第一次）。超过即落死信，事件不丢
CRITVAL_NOTIFY_MAX_ATTEMPTS=3
# 退避基数（秒）：第一次重试等这么久
CRITVAL_NOTIFY_BACKOFF_BASE_SECONDS=0.5
# 退避倍数：每重试一次等待时间乘这个数
CRITVAL_NOTIFY_BACKOFF_FACTOR=2
# 单次等待上限（秒）：再长也不该让危急值干等
CRITVAL_NOTIFY_MAX_BACKOFF_SECONDS=8
# 抖动比例：0=不抖动；0.2=等待时长在 ±20% 之间浮动（避免多台值班机同步重试）
CRITVAL_NOTIFY_JITTER_RATIO=0.2

# ---------- 守护进程运行参数（常驻进程 python -m critval.daemon） ----------
# 院内危急值报告制度（召回依据）。默认指向仓库内示例材料；
# 院内上线必须改成院内危急值报告制度的实际路径。
CRITVAL_POLICY_PATH=./samples/policy/示例危急值报告制度.docx
# ER7 帧投递目录：院内共享目录里放帧文件，守护进程取走并归档
CRITVAL_FRAME_DIR=./data/inbound_frames
# 材料投递目录：放阈值表 / 制度文件，指纹变了自动重装并切换规则集快照
CRITVAL_MATERIAL_DIR=./data/materials
# 处置卡不可变快照目录（值班台复核读快照，不重新渲染）
CRITVAL_SNAPSHOT_DIR=./data/card_snapshots
# 有界队列容量：队列满就拒收并留痕，不无限堆积内存
CRITVAL_QUEUE_SIZE=256
# 并发处理线程数
CRITVAL_WORKERS=2
# 心跳周期（秒）：每周期写一行心跳（队列深度 / 处理计数 / 最近错误）
CRITVAL_HEARTBEAT_SECONDS=30
# 定时任务周期（秒）：到期复查重推 + 崩溃续跑
CRITVAL_TIMER_INTERVAL_SECONDS=60

# ---------- 运行保障（常驻进程不掉链子） ----------
# 心跳文件路径：外部脚本读它判断「进程还在动吗」（原子写，随时可读）
CRITVAL_HEARTBEAT_PATH=./data/heartbeat.json
# 单实例锁文件路径：同一个数据目录只允许一个守护进程，第二个实例明确报错退出
CRITVAL_LOCK_PATH=./data/critval.lock
# 停机宽限期（秒）：收到停机信号后，在途事件处理不完就强制结束
CRITVAL_SHUTDOWN_GRACE_SECONDS=30
# 日志目录：按大小滚动写，目录内容不入库（.gitignore 已排除 logs/）
CRITVAL_LOG_DIR=./logs
# 单个日志文件上限（字节），超过就滚动
CRITVAL_LOG_MAX_BYTES=5242880
# 保留的历史日志份数（事后复核要翻旧日志，故不自动清空）
CRITVAL_LOG_BACKUP_COUNT=5
